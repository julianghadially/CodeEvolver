# CodeEvolver environment template. Run locally.

# -----------------------------------------------------------------------------
# 1. Core local run
# -----------------------------------------------------------------------------
APP_MODE=local            # local | dev | prod. `local` implies SANDBOX_MODE=local.
SANDBOX_MODE=local        # local (runs optimizations) | cloud (hosted portal API only)
STRATEGY=freeform         # freeform | ee | pareto_evolution | simple_loop

# Override for a different host/port or a dedicated database.
# LOCAL_MONGO_URI=mongodb://localhost:27017

# -----------------------------------------------------------------------------
# 2. Provider API keys
# -----------------------------------------------------------------------------
# Required for EVERY run regardless of harness: the constraint gate's judge is
# pinned to anthropic/claude-sonnet-5 (src/engine/optimizer/v3/lm_config.py).
# Without it the constraint gate can degrade.
ANTHROPIC_API_KEY=sk-ant-...
DEEPINFRA_API_KEY=
GMI_API_KEY=
# ALFWorld's task model (Qwen 3.6 35B-A3B) is served through OpenRouter.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# 3. Experiment fleet  (For orchestrating multiple runners via orchestrator — see specs/experiment-docs/experiment-fleet.md)
# -----------------------------------------------------------------------------
CE_BENCHMARKS=hover,phantomwiki,ragqa
CE_REPO_ROOT=~/Documents/code

# For per-benchmark path override: use CE_REPO_<SLUG>

# Where the controller collects finished runs (default ~/ce-runs). The analysis
# scripts read the same directory.
# CE_RUNS_DIR=~/ce-runs

# Container registry for runner images (controller, build.py, provision.sh).
# REGISTRY=registry.digitalocean.com/<your-registry>
# TAG=latest

# Controller state cache. Only a cache — truth is reconciled from `docker ps`
# plus each run's status.json, so deleting it is safe.
# CE_STATE=orchestrator/state.json


# -----------------------------------------------------------------------------
# 4. Optional overrides
# -----------------------------------------------------------------------------
# Artifact roots. Unset, these resolve to ~/.codeevolver/<name>/{job_id} in local
# mode. Inside a fleet container HOME=/artifacts, so they land in the host bind
# mount automatically — no need to set these there.
# CODEEVOLVER_TRACES_DIR=~/.codeevolver/traces
# CODEEVOLVER_MEMORY_DIR=~/.codeevolver/memory
# CODEEVOLVER_HISTORY_DIR=~/.codeevolver/history
# CODEEVOLVER_ARCHITECT_TRACES_DIR=~/.codeevolver/architect_traces
# CODEEVOLVER_LOGS_DIR=~/.codeevolver/logs

# Client venv layout inside the workspace (default env/bin).
# REPO_VENV_DIR=env
# REPO_VENV_BIN=bin

# OpenCode harness tuning.
# CODEEVOLVER_OPENCODE_SMALL_MODEL=
# CODEEVOLVER_SKIP_OPENCODE_VERSION_CHECK=1   # bypass the >=1.17.11 floor check
# CODEEVOLVER_ARCHITECT_MCP_CALL_TIMEOUT_SECONDS=

# pareto_evolution tuning.
# CODEEVOLVER_EVO_EXPLOIT_THRESHOLD=0.9
# CODEEVOLVER_EVO_EXPLOIT_K=

# LOG_LEVEL=INFO

# experiments/run.py targeting. Local mode bypasses auth, so the key is a
# placeholder unless you point at dev/prod.
# API_URL=http://127.0.0.1:8080
# LOCAL_API_KEY=local

# scripts/reset_repo.py -S (pushes saved runs to the dev API).
# CODEEVOLVER_API_URL=
# CODEEVOLVER_API_KEY=

# Hosted portal API only (SANDBOX_MODE=cloud): MongoDB Atlas connection. Dev
# reads the _DEV variants (MONGO_USER_DEV, ...).
# MONGO_HOST=<cluster>.mongodb.net
# MONGO_USER=
# MONGO_KEY=

# RAGQAArenaTech retriever. The fleet sets this to the in-network sidecar; set it
# by hand only when running ragqa outside a container.
# RAGQA_RETRIEVER_URL=http://localhost:8894/api/search

# Live coding-harness smokes (opt-in; they spend real provider money).
# CODEEVOLVER_LIVE_OPENCODE_SMOKE=1
# CODEEVOLVER_LIVE_CLAUDE_SMOKE=1
# CODEEVOLVER_LIVE_OPENCODE_MODEL=